# API Keys para el sistema de atención al cliente
# Descomenta y configura las API keys que tengas disponibles

# GROQ API Key (Recomendado para este proyecto)
GROQ_API_KEY=tu_groq_api_key_aqui

# Alternativas si no tienes GROQ
# OPENAI_API_KEY=tu_openai_api_key_aqui
# GOOGLE_API_KEY=tu_google_api_key_aqui

# Otras API keys disponibles (opcional)
# SERPER_API_KEY=tu_serper_api_key_aqui
# SEARCH_API_KEY=tu_search_api_key_aqui

# Configuración del modelo (opcional)
# GROQ_MODEL=llama3-70b-8192
# TEMPERATURE=0
