{
  "name": "news-query-system",
  "version": "1.0.0",
  "description": "Sistema inteligente de consulta de noticias usando LangChain y APIs gratuitas con interfaz web",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "web": "node server-optimized.js",
    "server": "node server-optimized.js",
    "console": "node main.js",
    "dev": "node --watch main.js",
    "dev:web": "node --watch server-optimized.js",
    "dev:server": "node --watch server-optimized.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "setup": "node setup.js",
    "install:deps": "npm install"
  },
  "keywords": [
    "langchain",
    "ai",
    "news",
    "nlp",
    "javascript",
    "llm",
    "web-interface",
    "socket.io",
    "express",
    "real-time"
  ],
  "author": "Sistema de Consulta de Noticias",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@langchain/community": "^0.2.4",
    "@langchain/google-genai": "^0.0.23",
    "@langchain/groq": "^0.0.12",
    "@langchain/openai": "^0.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "html-to-text": "^9.0.5",
    "jsdom": "^24.1.0",
    "langchain": "^0.2.3",
    "readline": "^1.3.0",
    "socket.io": "^4.7.2",
    "web-streams-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}